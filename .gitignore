# Built zips
dist/

# Safety copies the app makes before every save, and the half-written file a save is in the middle of
*.backup.json
apps/money/data/*.tmp-*
*.saving

# Exports from an accounts app stay on the person's computer, never in the kit
*.csv

# Computer clutter
.DS_Store
._*
Thumbs.db
desktop.ini

# Local Claude Code files that belong to one computer, not the kit
.claude/launch.json
.claude/settings.local.json
.claude/.cc-writes/

# Home layout: one person's choice of boxes, made while testing
apps/home/data/
__pycache__/
*.pyc

# The saved download of each tool as a customer installed it: theirs, not the kit's
setup/as-installed/*
!setup/as-installed/README.md
