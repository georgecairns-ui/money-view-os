# Built zips
dist/

# Safety copies the app makes before every save
*.backup.json
apps/money/data/*.tmp-*

# Exports from an accounts app stay on the person's computer, never in the kit
*.csv

# Computer clutter
.DS_Store
._*
Thumbs.db
desktop.ini

# Local Claude Code files that belong to one computer, not the kit
.claude/launch.json
.claude/settings.local.json
.claude/.cc-writes/

# Home layout: one person's choice of boxes, made while testing
apps/home/data/
__pycache__/
*.pyc
